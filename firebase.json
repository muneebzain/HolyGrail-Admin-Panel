{
  "hosting": {
    "site": "holygrails-admin-panel",
    "public": "build",
    "ignore": [ "firebase.json", "**/.*", "**/node_modules/**" ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "holygrail-stripe-api",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
